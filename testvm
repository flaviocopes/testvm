}

print_capabilities() {
  echo "testvm $VERSION"
  echo "Runs Mac app builds in a headless macOS VM so coding agents can launch, screenshot and click through them without taking over your screen."
  echo
  echo "What it can do:"
  echo "  Open an app build in the test VM"
  echo "    \$ testvm open build/Build/Products/Debug/Skillscout.app"
  echo "  Screenshot an app's window for visual checks"
  echo "    \$ testvm shot Skillscout"
  echo "  List UI controls with labels and click coordinates"
  echo "    \$ testvm ui Skillscout"
  echo "  Click at screen coordinates in the VM"
  echo "    \$ testvm click 255 200"
  echo "  Type text into the frontmost app"
  echo "    \$ testvm type 'Buy milk'"
  echo "  Press a keyboard shortcut or special key"
  echo "    \$ testvm key cmd+n"
  echo "  Copy test data or files into the VM"
  echo "    \$ testvm push ~/Documents/sample-notes/ Documents/sample-notes/"
  echo "  Tell VM Monitor what you are testing"
  echo "    \$ testvm note 'Checking the new Sort by usage menu in Skillscout'"
