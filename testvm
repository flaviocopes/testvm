    { "description": "Screenshot an app's window for visual checks", "command": "testvm shot Skillscout" },
    { "description": "List UI controls with labels and click coordinates", "command": "testvm ui Skillscout" },
    { "description": "Click at screen coordinates in the VM", "command": "testvm click 255 200" },
    { "description": "Type text into the frontmost app", "command": "testvm type 'Buy milk'" },
    { "description": "Press a keyboard shortcut or special key", "command": "testvm key cmd+n" },
    { "description": "Copy test data or files into the VM", "command": "testvm push ~/Documents/sample-notes/ Documents/sample-notes/" },
    { "description": "Tell VM Monitor what you are testing", "command": "testvm note 'Checking the new Sort by usage menu in Skillscout'" },
    { "description": "Check whether the test VM is running", "command": "testvm status" }
  ],
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-10-06",
      "changes": [
        "Moved to its own repo, flaviocopes/testvm",
        "Set the VM's image, cores, memory and display size in ~/.config/testvm/config",
        "Checks the host key of another Mac instead of trusting any machine at that name",
